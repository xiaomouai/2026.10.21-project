# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会被提交）
ADMIN_PASSWORD=
# 说明：后台 /admin/settings 里手填的大模型配置优先级更高；
#       这里填的环境变量只在后台没填对应项时兜底生效，适合 Docker 全新部署时注入。

# 阿里云百炼（DashScope）/ 任何 OpenAI 兼容接口的密钥
LLM_API_KEY=
# 可选：自定义接入地址，留空则用后台配置或内置默认（DashScope 兼容模式）
LLM_BASE_URL=
# 可选：模型名，留空则用后台配置或内置默认（qwen-plus）
LLM_MODEL=
# 可选：设为 1 表示启用 AI 助手（后台若显式关闭开关，此项不生效）
LLM_ENABLED=
