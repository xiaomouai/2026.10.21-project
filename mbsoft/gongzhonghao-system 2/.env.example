# 环境变量样例（复制为 .env 后填写，切勿提交真实密钥）

# 通知
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
LARK_WEBHOOK=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# 公众号 API
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 企业微信 / 私域
WECOM_CORP_ID=
WECOM_AGENT_ID=

# 数据源（广告/SEO 等）
ADS_API_KEY=

# 远程备份
RCLONE_REMOTE=
