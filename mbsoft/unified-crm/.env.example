# ===========================================================================
# UniCRM · 后端环境变量样例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会入库）
# 模型通道完全由环境变量决定，改完重启进程即生效，无需改代码。
# ===========================================================================

# ---------------------------------------------------------------------------
# 数据库
#   dev 默认 SQLite（prisma.config.ts 已处理，无需设置）
#   生产切换到 PostgreSQL：设 DATABASE_URL 并把 schema 换为 schema.postgres.prisma
# DATABASE_URL="postgresql://user:pass@host:5432/ucrm?schema=public"

# ---------------------------------------------------------------------------
# LLM 模型供应商（国内大模型对接）
#   通过 UCRM_LLM_PROVIDER 切换，三选一 + 自定义：
#     qwen      → 通义千问（阿里云百炼 DashScope）
#     deepseek  → DeepSeek
#     openai    → OpenAI
#     custom    → 任意 OpenAI 兼容端点（配 AI_BASE_URL + AI_API_KEY）
#   说明：qwen 与 dashscope 等价（qwen 是更易记的别名）。
# ---------------------------------------------------------------------------

# —— 方案 A：通义千问 Qwen（推荐国内）——
# UCRM_LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# AI_MODEL=qwen-plus          # 可选覆盖：qwen-max / qwen-turbo / qwen-long

# —— 方案 B：DeepSeek ——
# UCRM_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# AI_MODEL=deepseek-chat      # 可选覆盖：deepseek-reasoner

# —— 方案 C：OpenAI ——
# UCRM_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key

# —— 方案 D：自定义 OpenAI 兼容端点 ——
# UCRM_LLM_PROVIDER=custom
# AI_BASE_URL=https://your-endpoint/v1
# AI_API_KEY=sk-your-key
# AI_MODEL=your-model

# 通用兜底 key：可顶替任意 provider 的专属 key（不如专属 key 精确）
# AI_API_KEY=

# ---------------------------------------------------------------------------
# REST API 鉴权（生产环境务必配置，否则仍是开发期 X-Org-Slug 回退模式）
#   格式：slug1=key1,slug2=key2
#   调用方在 Authorization: Bearer <key> 中携带
# ---------------------------------------------------------------------------
# UCRM_API_KEYS="smoke-mts2za9y=ucrm_live_xxx"

# ---------------------------------------------------------------------------
# E2B 浏览器沙箱（可选，默认禁用并降级）
# E2B_API_KEY=
