# ===========================================================================

# Docker Hub 拉取慢时可切换基础镜像；默认值使用官方镜像。
# 腾讯云示例：mirror.ccs.tencentyun.com/library/node:22-bookworm-slim
# 阿里云请使用容器镜像服务控制台分配的专属 registry 地址。
NODE_IMAGE=node:22-bookworm-slim
POSTGRES_IMAGE=postgres:16-alpine
NPM_REGISTRY=https://registry.npmmirror.com/
# UniCRM · Docker 运行环境变量样例
# 复制为 .env.docker 后填入真实值（.env.docker 已被 .gitignore 忽略）
# 该文件由 docker-compose.yml 的 env_file 注入到 web / db 容器。
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL（db 服务）
# ---------------------------------------------------------------------------
POSTGRES_USER=ucrm
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=ucrm

# ---------------------------------------------------------------------------
# 数据库连接串（web 服务；compose 内用服务名 db，无需改主机）
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ucrm:请改成强密码@db:5432/ucrm?schema=public

# ---------------------------------------------------------------------------
# LLM 模型供应商（国内大模型对接）
#   qwen      → 通义千问（阿里云百炼 DashScope），配 DASHSCOPE_API_KEY
#   deepseek  → DeepSeek，配 DEEPSEEK_API_KEY
#   openai    → OpenAI，配 OPENAI_API_KEY
#   custom    → 任意 OpenAI 兼容端点，配 AI_BASE_URL + AI_API_KEY
# ---------------------------------------------------------------------------
UCRM_LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 通用兜底 key（可顶替任意 provider 专属 key）
AI_API_KEY=

# ---------------------------------------------------------------------------
# REST API 鉴权（生产务必配置；格式 slug1=key1,slug2=key2）
# ---------------------------------------------------------------------------
UCRM_API_KEYS=

# ---------------------------------------------------------------------------
# E2B 浏览器沙箱（可选，默认禁用）
# ---------------------------------------------------------------------------
E2B_API_KEY=

# ---------------------------------------------------------------------------
# 对外端口（宿主:容器）
# ---------------------------------------------------------------------------
BETTER_AUTH_URL=http://crm.mingboai.com:81
WEB_PORT=81
