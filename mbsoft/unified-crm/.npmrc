# ===========================================================================
# 国内镜像源（加速依赖安装）
#   - npm/pnpm 包：npmmirror（淘宝）
#   - Prisma 引擎二进制：npmmirror 二进制镜像
#   - better-sqlite3 预编译二进制：npmmirror 二进制镜像
# 该文件已提交，Docker 构建会复用；如需切回官方源删去即可。
# ===========================================================================
registry=https://registry.npmmirror.com/

# Prisma 引擎二进制镜像
@prisma/engines_binary_base_url=https://registry.npmmirror.com/-/binary/prisma
@prisma/client_binary_base_url=https://registry.npmmirror.com/-/binary/prisma

# better-sqlite3 预编译二进制镜像
better-sqlite3_binary_host=https://registry.npmmirror.com/-/binary/better-sqlite3
